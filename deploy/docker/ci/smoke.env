# Variables para pruebas sintéticas aisladas (sin Supabase real ni OAuth).
# compose.pgci.yaml proporciona el pooler sintético con TLS: salud 200.
# Sin ese override el host es irresoluble y la salud es 503.
ASIR_DATABASE_CONFIG=/etc/asir/database.json
ASIR_TOKEN_FILE=/etc/asir/tokens.json
ASIR_MODEL_DIR=/var/lib/asir/models/multilingual-e5-small
ASIR_PORT=8080
ASIR_PUBLIC_URL=http://127.0.0.1:18080
ASIR_ALLOWED_SUBJECTS=ASO
ASIR_DEFAULT_RPM=30
ASIR_MAX_PENDING=8
ASIR_LOG_LEVEL=INFO
ASIR_FORWARDED_ALLOW_IPS=127.0.0.1
PYTHONDONTWRITEBYTECODE=1
